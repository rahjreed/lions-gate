        {
          "from": "const row={id:run.id,nickname:cleanNickname(run.nickname),score:run.score,completed:run.completed,level:run.level,endedAt:run.endedAt};",
          "to": "const earned=topMasteryMedals(profile.medals,run.nickname);const row={id:run.id,nickname:cleanNickname(run.nickname),score:run.score,completed:run.completed,level:run.level,endedAt:run.endedAt,...(earned.length?{masteryMedals:earned}:{})};"
        }
      ]
